# ---- 监听 ----
# 直接对外就写 0.0.0.0:8443；放在 nginx 后面写 127.0.0.1:8080。
BIND=0.0.0.0:8443

# ---- DTK ----
# 同机 docker 一般是 http://127.0.0.1:8000；走 frp 则是 frps 在本机映射的端口。
DTK_BASE=http://127.0.0.1:8000
DTK_API_KEY=

# ---- 前端访问口令 ----
# 首次打开网页输入它换 cookie，之后不再需要。至少 8 位。
SITE_TOKEN=
# 可选：cookie 签名密钥。留空则由 SITE_TOKEN 派生。
SIGN_SECRET=

# ---- 静态站点 ----
# flutter build web 的产物目录。
STATIC_DIR=./static
# 打包下载的临时目录；systemd 下要在 unit 里用 ReadWritePaths 放行
BUNDLE_TMP=./tmp

# ---- 下载交付 ----
# proxy：服务端流式中转，浏览器会正常下载，文件名可控（默认）。
# redirect：302 让浏览器直连 CDN，零带宽，但 video/mp4 会被浏览器内联播放而不是下载。
DELIVERY=proxy

# ---- 安全 ----
# 每个 IP 每分钟允许的解析次数，0 = 不限。
PARSE_RATE_PER_MIN=20
# 会话有效期（小时）。
SESSION_TTL_HOURS=720
# 放在 nginx 后面才设 1，否则 X-Forwarded-For 可被伪造。
TRUST_PROXY=0
# 只有 HTTPS 部署才设 1。
COOKIE_SECURE=0
